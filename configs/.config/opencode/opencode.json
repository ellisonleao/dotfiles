{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/code/ls/**": "allow",
      "~/.config/nvim/**": "allow",
      "~/.claude/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git commit *": "ask",
      "git rm *": "ask",
      "rm *": "ask",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "npm *": "allow",
      "wc *": "allow",
      "npx *": "allow"
    }
  },
  "agent": {
    "plan": {
      "*": "allow"
    },
    "build": {
      "git *": "allow",
      "git commit *": "ask",
      "git rm *": "ask",
      "rm *": "ask",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "npm *": "allow",
      "wc *": "allow",
      "npx *": "allow"
    }
  },
  "mcp": {
    "atlassian": {
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "type": "local"
    },
    "postgres": {
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "environment": {
        "DATABASE_URI": "postgres://novadb:novadbareyoukiddingme@localhost:5432/nova?sslmode=disable"
      },
      "type": "local"
    },
    "sentry": {
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp"
    }
  }
}
